---
// 首页：模板库入口，自动列出 src/data/trades/ 下所有模板
import { glob } from 'astro/loaders';
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqList from '../components/FaqList.astro';

const modules = import.meta.glob('../data/trades/*.json', { eager: true });
const trades = Object.values(modules)
  .map((m: any) => m.default)
  .sort((a: any, b: any) => a.slug.localeCompare(b.slug));

// Blog — 取最新 3 篇放首页
const blogModules = import.meta.glob('../data/blog/*.json', { eager: true });
const blogPosts: any[] = Object.values(blogModules)
  .map((m: any) => m.default)
  .sort((a: any, b: any) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 3);

const faqs = [
  { q: "How many templates are available?", a: `Over ${trades.length} templates covering 25+ trades — plumbing, electrical, HVAC, roofing, concrete, landscaping, painting, welding and more. Each comes in PDF, Word, and Excel formats, so there are over ${trades.length * 3} downloadable files in total.` },
  { q: "Do you update the templates?", a: "Yes. When trade billing practices change (new permit requirements, common line items, tax rules), we update the corresponding template and redeploy. The Excel formulas and line items reflect how each trade actually bills today." },
  { q: "Can I use these templates for commercial work?", a: "Yes. Every template is free for commercial use — download without an email and use it for paying clients. The Word and Excel versions are editable so you can add your business name, logo, and license number. No attribution required." },
  { q: "What's the difference between the PDF, Word, and Excel versions?", a: "PDF is print-ready and locked — send it as-is. Word is fully editable text — best for adding your branding and adjusting layout. Excel has live formulas — type quantities and rates, and subtotal, tax, and total recalculate automatically. All three are free." },
];

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://fieldformtemplates.com';

// WebSite + Organization schema → sitelinks search box + 品牌知识面板
const websiteLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "FieldForm Templates",
  url: siteUrl,
  description: "Free invoice and estimate templates for trades — Excel auto-calculates tax and totals.",
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: `${siteUrl}/search?q={search_term_string}`,
    },
    "query-input": "required name=search_term_string",
  },
});

const orgLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "FieldForm Templates",
  url: siteUrl,
  logo: `${siteUrl}/og-image.png`,
  description: "Free invoice and estimate templates for home-service trades.",
  areaServed: "US",
});

// ItemList — 列出所有模板,提升内链发现 + 富摘要
const itemListLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Free Invoice & Estimate Templates for Trades",
  numberOfItems: trades.length,
  itemListElement: trades.map((t: any, i: number) => ({
    "@type": "ListItem",
    position: i + 1,
    name: t.title,
    url: `${siteUrl}/templates/${t.slug}/`,
  })),
});
---
<BaseLayout
  title="Free Invoice & Estimate Templates for Trades — FieldForm Templates"
  description="Free invoice & estimate templates for 50+ trades — solar, plumbing, HVAC, concrete, roofing, electrical, painting and more. Excel auto-calculates tax and totals. Download as PDF, Word, or Excel."
>
  <script is:inline type="application/ld+json" set:html={websiteLd}></script>
  <script is:inline type="application/ld+json" set:html={orgLd}></script>
  <script is:inline type="application/ld+json" set:html={itemListLd}></script>
  <section class="section wrap" style="padding-top:64px;">
    <div class="section-head">
      <h1>Free invoice &amp; estimate templates for trades</h1>
      <p class="lead">Professional templates pre-filled for how each trade actually bills — call-out fees, permits, labor and materials. Excel versions auto-calculate tax and totals.</p>
    </div>
    <p style="margin-top:18px;">
      <a href="https://www.producthunt.com/products/fieldform-invoice-calculator?embed=true&amp;utm_source=badge-featured&amp;utm_medium=badge&amp;utm_campaign=badge-fieldform-invoice-calculator" target="_blank" rel="noopener noreferrer" style="display:inline-flex;align-items:center;gap:8px;padding:7px 14px;border:1px solid #ffd6d1;background:#fff7f6;border-radius:999px;font-size:13.5px;font-weight:600;color:var(--ink);text-decoration:none;">
        <span aria-hidden="true">🚀</span> Our invoice calculator launches on Product Hunt Tue, Oct&nbsp;20 — follow the launch
      </a>
    </p>
  </section>

  <section class="section wrap" style="padding-top:0;">
    <p class="how-to-use-body">
      Every template on this site is free to download — no email, no signup, no watermark. Pick your trade, pick your format (PDF, Word, or Excel), and you have a professional invoice or estimate in under five minutes. The <strong>Excel versions</strong> ship with live formulas for subtotal, tax, and total — just enter your quantities and rates, and the math updates itself. The <strong>Word versions</strong> are fully editable: drop in your logo, change the accent color, swap fonts to match your brand. Every template is pre-filled with the line items that trade actually uses — a plumber's invoice has call-out fee, labor, parts, and warranty; an electrician's has panels, fixtures, and permits; a <a href="/templates/tiling-estimate-template/" style="color:var(--blue);font-weight:600;">tile job estimate</a> has installation per sq ft, grouting, demo, and waterproofing — so you start from something realistic, not a blank table. All templates include fields for your business name, license number, client details, payment terms, and due date. Download as many as you need, for as many trades as you work in.
    </p>
  </section>

  <section class="section wrap" id="popular" style="padding-top:8px;">
    <div class="section-head">
      <h2>Most searched templates</h2>
      <p>The templates trades are looking for right now — pre-filled, free to download.</p>
    </div>
    <div class="grid3">
      <a class="card" style="text-decoration:none;color:var(--ink);" href="/templates/pest-control-invoice-template/">
        <span style="display:inline-block;font-size:12px;font-weight:700;letter-spacing:.4px;color:var(--teal);text-transform:uppercase;margin-bottom:8px;">invoice</span>
        <h3 style="margin-bottom:6px;">Pest Control Invoice</h3>
        <p style="color:var(--muted);font-size:14px;">Service call, treatment, chemicals, warranty — pre-filled for pest control billing.</p>
      </a>
      <a class="card" style="text-decoration:none;color:var(--ink);" href="/templates/electrician-invoice-template/">
        <span style="display:inline-block;font-size:12px;font-weight:700;letter-spacing:.4px;color:var(--teal);text-transform:uppercase;margin-bottom:8px;">invoice</span>
        <h3 style="margin-bottom:6px;">Electrician Invoice</h3>
        <p style="color:var(--muted);font-size:14px;">Panels, fixtures, permits, labor — pre-filled for how electricians actually bill.</p>
      </a>
      <a class="card" style="text-decoration:none;color:var(--ink);" href="/templates/tiling-estimate-template/">
        <span style="display:inline-block;font-size:12px;font-weight:700;letter-spacing:.4px;color:var(--teal);text-transform:uppercase;margin-bottom:8px;">estimate</span>
        <h3 style="margin-bottom:6px;">Tile Job Estimate</h3>
        <p style="color:var(--muted);font-size:14px;">Installation per sq ft, labor, grouting, demo, waterproofing — quote a tile job in minutes.</p>
      </a>
      <a class="card" style="text-decoration:none;color:var(--ink);" href="/templates/hvac-invoice-template/">
        <span style="display:inline-block;font-size:12px;font-weight:700;letter-spacing:.4px;color:var(--teal);text-transform:uppercase;margin-bottom:8px;">invoice</span>
        <h3 style="margin-bottom:6px;">HVAC Invoice</h3>
        <p style="color:var(--muted);font-size:14px;">System install, service call, parts, labor — pre-filled for HVAC billing.</p>
      </a>
      <a class="card" style="text-decoration:none;color:var(--ink);" href="/templates/locksmith-invoice-template/">
        <span style="display:inline-block;font-size:12px;font-weight:700;letter-spacing:.4px;color:var(--teal);text-transform:uppercase;margin-bottom:8px;">invoice</span>
        <h3 style="margin-bottom:6px;">Locksmith Invoice</h3>
        <p style="color:var(--muted);font-size:14px;">Service call, rekey, lock install, emergency call-out — pre-filled for locksmiths.</p>
      </a>
      <a class="card" style="text-decoration:none;color:var(--ink);" href="/templates/electrician-estimate-template/">
        <span style="display:inline-block;font-size:12px;font-weight:700;letter-spacing:.4px;color:var(--teal);text-transform:uppercase;margin-bottom:8px;">estimate</span>
        <h3 style="margin-bottom:6px;">Electrical Estimate</h3>
        <p style="color:var(--muted);font-size:14px;">Panels, wiring, fixtures, permits — quote electrical work with deposit terms.</p>
      </a>
    </div>
  </section>

  <section class="section wrap" id="templates" style="padding-top:8px;">
    <div class="section-head">
      <h2>All templates</h2>
      <p>Browse the full library — {trades.length} templates across every trade.</p>
    </div>
    <div class="grid2">
      {trades.map((t: any) => (
        <a class="tpl-card" href={`/templates/${t.slug}/`}
           onclick={`if(window.gtag)gtag('event','select_item',{item_id:'${t.slug}',item_category:'${t.docType}'});`}>
          <span class="tag">{t.docType}</span>
          <h3>{t.title}</h3>
          <p>{t.subtitle}</p>
          <span class="go">View &amp; download →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section wrap" id="categories" style="padding-top:8px;">
    <div class="grid2">
      <a class="tpl-card" href="/invoice-templates/">
        <span class="tag">36 templates</span>
        <h3>Browse all invoice templates →</h3>
        <p>Every trade's invoice template in one place — pre-filled line items, auto-calculating Excel, free download.</p>
        <span class="go">View all invoices →</span>
      </a>
      <a class="tpl-card" href="/estimate-templates/">
        <span class="tag">15 templates</span>
        <h3>Browse all estimate templates →</h3>
        <p>Every trade's estimate template in one place — quote a job with pre-filled line items and deposit terms.</p>
        <span class="go">View all estimates →</span>
      </a>
    </div>
  </section>

  <section class="section wrap" id="guides" style="padding-top:8px;">
    <div class="section-head">
      <h2>Invoicing guides</h2>
      <p>How to write a proper invoice for your trade — line items, pricing, and tax rules.</p>
    </div>
    <div class="grid3">
      <a class="card" style="text-decoration:none;color:var(--ink);" href="/guides/">
        <h3 style="margin-bottom:6px;">Browse all guides →</h3>
        <p style="color:var(--muted);font-size:14px;">Step-by-step invoicing guides for plumbers, HVAC, electricians, roofers, pest control and more.</p>
      </a>
      <a class="card" style="text-decoration:none;color:var(--ink);" href="/invoice-calculator/">
        <span class="tag">Free tool</span>
        <h3 style="margin-bottom:6px;">Invoice calculator →</h3>
        <p style="color:var(--muted);font-size:14px;">Add labor, materials, and tax — get the total instantly. No signup, runs in your browser.</p>
      </a>
    </div>
  </section>

  <section class="section wrap" id="blog" style="padding-top:8px;">
    <div class="section-head">
      <h2>From the blog</h2>
      <p>Invoicing tips, tax rules, and business advice for trade contractors.</p>
    </div>
    <div class="grid3">
      {blogPosts.map((p: any) => (
        <a class="card" style="text-decoration:none;color:var(--ink);" href={`/blog/${p.slug}/`}>
          <span style="display:inline-block;font-size:12px;font-weight:700;letter-spacing:.4px;color:var(--teal);text-transform:uppercase;margin-bottom:8px;">{p.category}</span>
          <h3 style="margin-bottom:6px;">{p.title}</h3>
          <p style="color:var(--muted);font-size:14px;">{p.description.slice(0, 100)}{p.description.length > 100 ? '…' : ''}</p>
        </a>
      ))}
    </div>
    <p style="margin-top:16px;"><a href="/blog/" style="font-weight:700;color:var(--blue);">Browse all blog articles →</a></p>
  </section>

  <section class="section wrap" id="why">
    <div class="section-head">
      <h2>Why use these templates</h2>
      <p>Built for the way a trade business actually bills a job.</p>
    </div>
    <div class="grid3">
      <div class="card">
        <svg width="30" height="30" viewBox="0 0 32 32" fill="none" stroke="#1668D4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="4" width="20" height="24" rx="2"/><path d="M6 12h20M6 18h20M6 24h20M13 12V4M19 12V4"/></svg>
        <h3>Auto-calculating tax</h3>
        <p>Enter your state rate once in the Excel version — subtotal, tax and total update automatically.</p>
      </div>
      <div class="card">
        <svg width="30" height="30" viewBox="0 0 32 32" fill="none" stroke="#0F766E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 6.5l11 11a3 3 0 0 1 0 4.2l-3.8 3.8a3 3 0 0 1-4.2 0l-11-11z"/><path d="M14 8L6 16l7 7 8-8M19 3l2 2M27 11l2 2M9 14L5 10"/></svg>
        <h3>Pre-filled line items</h3>
        <p>Call-out fees, permits, labor, materials and warranty — already laid out for a service call.</p>
      </div>
      <div class="card">
        <svg width="30" height="30" viewBox="0 0 32 32" fill="none" stroke="#1668D4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3l11 4v7c0 6.5-4.7 11.4-11 13C9.7 25.4 5 20.5 5 14V7z"/><path d="M12 16l3 3 6-6"/></svg>
        <h3>License &amp; tax ID fields</h3>
        <p>Most states require a contractor license number on client-facing invoices. The templates include the fields up front.</p>
      </div>
    </div>
  </section>

  <section class="section wrap" id="faq">
    <div class="section-head">
      <h2>Questions</h2>
    </div>
    <FaqList faqs={faqs} />
  </section>
</BaseLayout>
