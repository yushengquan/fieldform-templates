---
// 全站布局：head SEO + 导航 + 页脚 + toast 脚本
import '../styles/global.css';
interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
}
const { title, description, canonical, ogImage } = Astro.props;
const site = Astro.site?.toString() ?? 'https://fieldform-templates.pages.dev';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site).toString();
const imageUrl = new URL(ogImage ?? '/og-image.png', site).toString();
---
<!DOCTYPE html>
<html lang="en-US">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="index,follow,max-image-preview:large">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalUrl}>
  <link rel="alternate" hreflang="en-US" href={canonicalUrl}>
  <link rel="alternate" hreflang="x-default" href={canonicalUrl}>
  <link rel="alternate" type="application/rss+xml" title="FieldForm Templates Blog" href="/rss.xml">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/fonts/archivo-700.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/archivo-800.woff2" as="font" type="font/woff2" crossorigin>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:image" content={imageUrl}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:site_name" content="FieldForm Templates">
  <meta property="og:locale" content="en_US">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@fieldformtpl">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={imageUrl}>
  <script type="text/partytown" defer src="https://www.googletagmanager.com/gtag/js?id=G-FWVBSQTZVH"></script>
  <script type="text/partytown">
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-FWVBSQTZVH');
  </script>
  <!-- Google AdSense (publisher ca-pub-5456484289295797) -->
  <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5456484289295797" crossorigin="anonymous"></script>
</head>
<body>
  <header class="site-header">
    <div class="wrap nav">
      <a class="brand" href="/">
        <svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="7" fill="#1668D4"/><path d="M9 7h10l4 4v14H9z" fill="none" stroke="#fff" stroke-width="2.2"/><path d="M13 17h8M13 21h6" stroke="#fff" stroke-width="2" stroke-linecap="round"/></svg>
        FieldForm Templates
      </a>
      <nav class="nav-links">
        <a href="/#templates">Templates</a>
        <a href="/invoice-calculator/">Calculator</a>
        <a href="/guides/">Guides</a>
        <a href="/blog/">Blog</a>
        <a href="/#why">Why</a>
        <a href="/about/">About</a>
        <a href="/#faq">FAQ</a>
      </nav>
    </div>
  </header>
  <main>
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap foot-inner">
      <span>FieldForm Templates — free invoice &amp; estimate templates for trades</span>
      <span>Template for informational purposes only; does not constitute legal, tax, or accounting advice.</span>
      <nav style="display:flex;gap:20px;flex-wrap:wrap;font-size:14px;" aria-label="Footer">
        <a href="/about/" style="color:var(--muted);">About</a>
        <a href="/blog/" style="color:var(--muted);">Blog</a>
        <a href="/guides/" style="color:var(--muted);">Guides</a>
        <a href="/best-invoicing-apps-for-contractors/" style="color:var(--muted);">Software guide</a>
        <a href="/editorial-standards/" style="color:var(--muted);">Editorial standards</a>
        <a href="/affiliate-disclosure/" style="color:var(--muted);">Affiliate disclosure</a>
        <a href="/contact/" style="color:var(--muted);">Contact</a>
        <a href="/privacy/" style="color:var(--muted);">Privacy</a>
        <a href="/terms/" style="color:var(--muted);">Terms</a>
      </nav>
      <div style="margin-top:12px;display:flex;gap:12px;align-items:center;flex-wrap:wrap;">
        <a href="https://amaze.directory/tools/fieldform-templates" target="_blank" rel="noopener" title="FieldForm Templates on amaze.directory"><img src="https://amaze.directory/badge/dark.svg" alt="FieldForm Templates is listed on amaze.directory" width="181" height="46" loading="lazy" /></a>
        <a href="https://www.listbulb.com/tools/fieldform-templates" target="_blank" rel="noopener">
          <img src="https://www.listbulb.com/featured-on-listbulb-light.svg" alt="Featured on ListBulb" width="180" height="48" loading="lazy" />
        </a>
        <a href="https://twelve.tools" target="_blank" rel="noopener">
          <img src="https://twelve.tools/badge0-white.svg" alt="Featured on Twelve Tools" width="148" height="40" loading="lazy" />
        </a>
        <a href="https://daniellaunches.com" target="_blank" rel="noopener">
          <img src="https://daniellaunches.com/badge-light.svg" alt="Featured on DanielLaunches" width="220" height="48" loading="lazy" />
        </a>
        <a href="https://huzzler.so/products/ykhAQqH3hN/fieldform-templates?utm_source=huzzler_product_website&utm_medium=badge&utm_campaign=free_listing" target="_blank" rel="noopener noreferrer">
          <img src="https://huzzler.so/assets/images/embeddable-badges/featured-light.png" alt="Featured on Huzzler" width="159" height="55" loading="lazy" />
        </a>
        <a href="https://startupfa.st" target="_blank" title="Powered by Startup Fast">
          <img src="https://startupfa.st/images/badges/powered-by-light.svg" alt="Powered by Startup Fast" width="150" height="44" loading="lazy" />
        </a>
        <a href="https://saasbison.com" target="_blank" rel="dofollow">
          <img src="https://saasbison.com/badge.png" alt="Featured on SaaSBison" width="200" height="54" loading="lazy" />
        </a>
        <a href="https://dododirectory.com" target="_blank" rel="dofollow">
          <img src="https://dododirectory.com/badge-light.png" alt="Featured on DodoDirectory" width="200" height="54" loading="lazy" />
        </a>
        <a href="https://deeplaunch.io" target="_blank" rel="dofollow" title="Featured on DeepLaunch.io">
          <img src="https://deeplaunch.io/badge/badge_dark.svg" alt="Featured on DeepLaunch.io" width="200" height="54" loading="lazy" style="background:#fff;border-radius:6px;padding:2px;" />
        </a>
        <a href="https://thesaasdir.com/product/fieldform-templates?ref=badge" target="_blank" rel="dofollow" title="Featured on TheSaaSDir">
          <img src="https://thesaasdir.com/badge/fieldform-templates.svg" alt="Featured on TheSaaSDir" width="182" height="46" loading="lazy" />
        </a>
        <a href="https://shipstry.com/" target="_blank" rel="noopener" title="Featured on Shipstry">
          <img src="https://shipstry.com/badges/featured.svg" alt="Featured on Shipstry" width="220" height="52" loading="lazy" />
        </a>
        <a href="https://findly.tools/" target="_blank" rel="noopener" title="Featured on Findly">
          <img src="https://findly.tools/badges/findly-tools-badge-light.svg" alt="Featured on Findly" width="200" height="52" loading="lazy" />
        </a>
      </div>
      <p style="margin-top:10px;font-size:14px;">
        <a href="/featured-on/" style="color:var(--muted);">See all directories &amp; launch platforms where we are featured →</a>
      </p>
    </div>
  </footer>
  <div id="toast" role="status" aria-live="polite"></div>
  <script is:inline>
    (function () {
      var toast = document.getElementById('toast');
      var t = null;
      window.showToast = function (msg) {
        if (!toast) return;
        toast.textContent = msg;
        toast.classList.add('show');
        if (t) clearTimeout(t);
        t = setTimeout(function () { toast.classList.remove('show'); }, 2600);
      };
    })();
  </script>
  <script is:inline>
    // Embed mode: ?embed=1 strips site chrome so the page can be iframed as a widget.
    (function () {
      if (!/[?&]embed=1/.test(location.search)) return;
      var s = document.createElement('style');
      s.textContent = 'header.site-header,footer,.breadcrumb,#toast{display:none!important}' +
        'main,body{padding-top:0!important}' +
        'body{background:#fff}';
      document.head.appendChild(s);
    })();
  </script>
</body>
</html>
