  <style>
    .calc-input{width:100%;padding:10px 12px;border:1px solid var(--line);border-radius:8px;font-size:16px;font-family:inherit;background:var(--surface);color:var(--ink);}
    .calc-input:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px rgba(22,104,212,.12);}
    @media(max-width:720px){.grid2{grid-template-columns:1fr !important;}}
  </style>
  <script is:inline>
    (function(){
      var D = function(id){ return document.getElementById(id); };
      var fmt = function(n){ return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); };
      function num(id){ var v = parseFloat(D(id).value); return isNaN(v) || v < 0 ? 0 : v; }
      function laborSum(){
        var total = 0, hrs = 0, rows = 0;
        document.querySelectorAll('.labor-row').forEach(function(row){
          var h = parseFloat(row.querySelector('.labor-hrs').value) || 0;
          var r = parseFloat(row.querySelector('.labor-rate').value) || 0;
          if (h > 0 && r > 0) { total += h * r; hrs += h; rows++; }
        });
        return { total: total, hrs: hrs, rows: rows };
      }
      function matCost(){
        var s = 0;
        document.querySelectorAll('.mat-cost').forEach(function(el){
          var v = parseFloat(el.value); if(!isNaN(v) && v > 0) s += v;
        });
        return s;
      }
      function calc(){
        var L = laborSum();
        var matsCost = matCost();
        var mk = num('markup');
        var mats = matsCost * (1 + mk / 100);
        var other = num('mob') + num('misc');
        var sub = L.total + mats + other;
        var taxRate = num('tax');
        var tax = sub * taxRate / 100;
        var total = sub + tax;
        var depPct = num('deposit');
        var dep = total * depPct / 100;
        D('labor-line').textContent = L.hrs + ' hrs across ' + L.rows + ' process' + (L.rows === 1 ? '' : 'es') + ' = ' + fmt(L.total);
        D('r-labor').textContent = fmt(L.total);
        D('mat-label').textContent = 'Materials (incl. ' + mk + '% markup)';
        D('r-materials').textContent = fmt(mats);
        D('r-other').textContent = fmt(other);
        D('r-subtotal').textContent = fmt(sub);
        D('r-tax').textContent = fmt(tax);
        D('tax-label').textContent = 'Tax (' + taxRate + '%)';
        D('r-total').textContent = fmt(total);
        D('deposit-label').textContent = 'Deposit at signing (' + depPct + '%)';
        D('r-deposit').textContent = fmt(dep);
        D('r-balance').textContent = fmt(total - dep);
      }
      D('add-labor').addEventListener('click', function(){
        var list = D('labor-list');
        var row = document.createElement('div');
        row.className = 'labor-row';
        row.style.cssText = 'display:grid;grid-template-columns:1fr 90px 100px 32px;gap:8px;margin-bottom:8px;align-items:end;';
        row.innerHTML = '<input type="text" class="labor-name calc-input" placeholder="Process (e.g. Flux-core)" style="font-size:14px;" />' +
          '<input type="number" class="labor-hrs calc-input" min="0" step="0.5" placeholder="Hrs" style="font-size:14px;text-align:right;" />' +
          '<input type="number" class="labor-rate calc-input" min="0" step="5" placeholder="$/hr" style="font-size:14px;text-align:right;" />' +
          '<button class="labor-del" style="padding:10px;border:1px solid var(--line);border-radius:8px;background:var(--surface);cursor:pointer;color:var(--muted);font-size:16px;">×</button>';
        list.appendChild(row);
        row.querySelectorAll('input').forEach(function(el){ el.addEventListener('input', calc); });
        row.querySelector('.labor-del').addEventListener('click', function(){ row.remove(); calc(); });
        calc();
      });
      D('add-mat').addEventListener('click', function(){
        var list = D('materials-list');
        var row = document.createElement('div');
        row.className = 'mat-row';
        row.style.cssText = 'display:grid;grid-template-columns:1fr 100px 32px;gap:8px;margin-bottom:8px;align-items:end;';
        row.innerHTML = '<input type="text" class="mat-name calc-input" placeholder="Item" style="font-size:14px;" />' +
          '<input type="number" class="mat-cost calc-input" min="0" step="0.01" placeholder="Cost $" style="font-size:14px;text-align:right;" />' +
          '<button class="mat-del" style="padding:10px;border:1px solid var(--line);border-radius:8px;background:var(--surface);cursor:pointer;color:var(--muted);font-size:16px;">×</button>';
        list.appendChild(row);
        row.querySelectorAll('input').forEach(function(el){ el.addEventListener('input', calc); });
        row.querySelector('.mat-del').addEventListener('click', function(){ row.remove(); calc(); });
        calc();
      });
      document.querySelectorAll('.labor-del,.mat-del').forEach(function(btn){
        btn.addEventListener('click', function(){
          var row = btn.closest('.labor-row,.mat-row');
          var cls = row.classList.contains('labor-row') ? '.labor-row' : '.mat-row';
          if(row && document.querySelectorAll(cls).length > 1){ row.remove(); calc(); }
        });
      });
      document.querySelectorAll('.calc-input').forEach(function(el){ el.addEventListener('input', calc); });
      D('copy-btn').addEventListener('click', function(){
        if (window.gtag) gtag('event', 'welding_calc_copy');
        var lines = [];
        lines.push('Welding labor: ' + D('r-labor').textContent);
        lines.push(D('mat-label').textContent + ': ' + D('r-materials').textContent);
        lines.push('Mobilization & prep: ' + D('r-other').textContent);
        lines.push('Subtotal: ' + D('r-subtotal').textContent);
        lines.push(D('tax-label').textContent + ': ' + D('r-tax').textContent);
        lines.push('TOTAL: ' + D('r-total').textContent);
        lines.push(D('deposit-label').textContent + ': ' + D('r-deposit').textContent);
        lines.push('Balance on completion: ' + D('r-balance').textContent);
        var text = lines.join('\n');
        if(navigator.clipboard){
          navigator.clipboard.writeText(text).then(function(){
            var msg = D('copy-msg'); msg.style.display = 'block';
            setTimeout(function(){ msg.style.display = 'none'; }, 2500);
          });
        }
      });
      calc();
    })();
  </script>
</BaseLayout>
