---
import BaseLayout from '../layouts/BaseLayout.astro';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://fieldformtemplates.com';
const title = 'Contractor License Requirements by State (2026) — Reference';
const description = 'Which states license trade contractors, which board issues the license, and what licence number belongs on your invoice. A reference table for electricians';
const canonical = `${siteUrl}/contractor-license-requirements-by-state/`;

// Verified against state board names; verify current rules before relying on any line.
const states = [
  {
    state: 'California',
    board: 'CSLB (Contractors State License Board)',
    structure: 'Statewide licence required for any job over $500 in labour and materials. Class B general building plus trade classifications: C-9 drywall, C-10 electrical, C-36 plumbing, C-20 HVAC, C-39 roofing, C-27 landscaping, C-61 limited specialty.',
    invoice: 'Licence number required on contracts, invoices and ads. Check the number at cslb.ca.gov before you pay a subcontractor.',
  },
  {
    state: 'Texas',
    board: 'TDLR (HVAC, electrical sign) · TDA (structural pest control) · no statewide general contractor licence',
    structure: 'No statewide general contractor licence. HVAC contractors licence through TDLR; electrical work is licensed at the municipal level, so requirements differ between Houston, Dallas, Austin and San Antonio. Pest control is licensed by the Texas Department of Agriculture.',
    invoice: 'Print the TDLR or TDA licence number where one applies. For municipal electrical work, keep the local registration number on file.',
  },
  {
    state: 'Florida',
    board: 'DBPR / CILB (construction) · FDACS (pest control)',
    structure: 'State-certified or registered contractor through CILB: CGC (general), CBC (building), CRC (residential). Counties also issue local competency cards. Pest control businesses licence through FDACS with a certified operator per category.',
    invoice: 'State certification number or county competency card number, plus FDACS licence for pest work.',
  },
  {
    state: 'New York',
    board: 'NYC DOB / local municipalities (construction) · NYSDEC (pesticide applicators)',
    structure: 'No statewide general contractor licence. New York City, Buffalo, Rochester and most upstate cities issue their own. Commercial pesticide applicators are certified through the DEC, and Long Island counties add their own pesticide rules on top.',
    invoice: 'The local licence number where the work is performed; DEC certification number for pest applications.',
  },
  {
    state: 'Washington',
    board: 'L&I (Department of Labor & Industries)',
    structure: 'Statewide registration required for all contractors, plus separate electrician and plumber certification through L&I. A registered contractor number is issued to the business; individual trades hold certificates.',
    invoice: 'Contractor registration number (starts with FIELD or a UBI) on invoices and advertisements.',
  },
  {
    state: 'Oregon',
    board: 'CCB (Construction Contractors Board)',
    structure: 'All contractors must be licensed with the CCB, including handymen working over the threshold. Electrical and plumbing hold separate state licences through the Building Codes Division.',
    invoice: 'CCB licence number on every invoice, contract and vehicle.',
  },
  {
    state: 'Arizona',
    board: 'ROC (Registrar of Contractors)',
    structure: 'Statewide licensing through the ROC with residential and commercial classifications. Specialty trades — electrical, plumbing, HVAC, roofing — each hold their own classification under the same board.',
    invoice: 'ROC licence number, and the classification that matches the work performed.',
  },
  {
    state: 'Illinois',
    board: 'No statewide general contractor licence · IDOL (some trades) · local municipalities',
    structure: 'Illinois does not license general contractors statewide. Chicago, Cook County and most larger cities issue their own licences. Electrical and plumbing are licensed at the municipal level; roofing is largely unlicensed.',
    invoice: 'The local licence or registration number for the jurisdiction where the work happens.',
  },
  {
    state: 'Georgia',
    board: 'GA SOS Professional Licensing Boards',
    structure: 'Residential and general contractor licences are issued by the state, with separate utility contractor and electrical classifications. Local governments may add requirements.',
    invoice: 'State licence number for the classification used on the job.',
  },
  {
    state: 'North Carolina',
    board: 'NC Licensing Board for General Contractors',
    structure: 'General contractor licence required above a project value threshold (currently $30,000). Electrical, plumbing, HVAC and fire sprinkler trades licence separately through the state boards.',
    invoice: 'Licence number for the general contractor or the individual trade licence, whichever applies.',
  },
  {
    state: 'Ohio',
    board: 'No statewide general contractor licence · OCILB (electrical, plumbing, HVAC)',
    structure: 'Ohio licenses electrical, plumbing and HVAC contractors through the Ohio Construction Industry Licensing Board, but leaves general contracting to municipalities and counties.',
    invoice: 'OCILB licence number for the licensed trades; local registration for general work.',
  },
  {
    state: 'Pennsylvania',
    board: 'Attorney General HIC registration · no statewide trade licence',
    structure: 'Home improvement contractors must register with the state (HIC registration) for residential work over $5,000. Electrical work is licensed by municipalities; plumbing likewise varies by city.',
    invoice: 'HIC registration number for residential home improvement contracts.',
  },
];

const faqs = [
  {
    q: 'Do I have to put my licence number on every invoice?',
    a: 'In most licensed states, yes — and it is usually required on contracts and advertising too, not only invoices. California, Oregon, Washington, Arizona and Florida all expect the number to appear on documents the customer keeps, because that is what the customer or their insurer uses to verify you.',
  },
  {
    q: 'Which number goes on the invoice if I both hold an individual certificate and work for a licensed company?',
    a: 'The company-level number. An individual certificate identifies the person qualified to supervise work, but the contract and the invoice belong to the licensed business. Printing the certificate number alone is a common error that causes payment holds on commercial jobs.',
  },
  {
    q: 'What about specialty trades that need a separate licence?',
    a: 'Pest control, electrical, plumbing, HVAC and fire protection almost always carry their own licence or certification separate from a general contractor licence. If a job touches one of those scopes, both numbers may belong on the invoice — the GC licence for the contract and the trade licence for the scope performed.',
  },
  {
    q: 'Does an out-of-state licence let me work across a state line?',
    a: 'Almost never. Trade licences are state-specific and there is limited reciprocity — electrical and plumbing occasionally have reciprocal agreements between neighbouring states, but you generally need to apply in the state where the work is performed. Working unlicensed voids most insurance policies and can make the contract unenforceable.',
  },
];
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <section class="section wrap" style="padding-top:40px;">
    <div class="section-head">
      <h1 style="font-size:34px;line-height:1.2;margin-bottom:14px;">Contractor licence requirements by state</h1>
      <p style="font-size:17px;color:var(--muted);max-width:820px;">Which states actually license trade contractors, which board issues it, and which number belongs on the invoice you hand the customer. Twelve states that cover most of the US contractor market, written for the person filling out the paperwork — not for a lawyer.</p>
    </div>

    <div style="margin-top:26px;padding:18px 22px;background:var(--soft);border-radius:12px;border-left:4px solid var(--blue);">
      <p style="font-size:15px;line-height:1.65;margin:0;"><strong>Why this matters on an invoice:</strong> a licence number is the document a customer's insurer, a real-estate closing or a state auditor uses to check that the work was done legitimately. An invoice without it can be refused on a commercial job and can stall an insurance claim on a residential one.</p>
    </div>

    <div style="margin-top:32px;overflow-x:auto;">
      <table style="width:100%;border-collapse:collapse;font-size:14.5px;line-height:1.6;">
        <thead>
          <tr style="background:var(--soft);text-align:left;">
            <th style="padding:12px 14px;border-bottom:2px solid var(--line);">State</th>
            <th style="padding:12px 14px;border-bottom:2px solid var(--line);">Who licenses</th>
            <th style="padding:12px 14px;border-bottom:2px solid var(--line);">Structure</th>
            <th style="padding:12px 14px;border-bottom:2px solid var(--line);">Number that goes on the invoice</th>
          </tr>
        </thead>
        <tbody>
          {states.map((s) => (
            <tr>
              <td style="padding:14px;border-bottom:1px solid var(--line);font-weight:700;white-space:nowrap;vertical-align:top;">{s.state}</td>
              <td style="padding:14px;border-bottom:1px solid var(--line);color:var(--muted);vertical-align:top;">{s.board}</td>
              <td style="padding:14px;border-bottom:1px solid var(--line);vertical-align:top;">{s.structure}</td>
              <td style="padding:14px;border-bottom:1px solid var(--line);color:var(--muted);vertical-align:top;">{s.invoice}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p style="margin-top:16px;font-size:13.5px;color:var(--muted);">Rules change and local jurisdictions frequently add requirements on top of state law. Verify with the board listed before relying on any line — this table is a starting point, not legal advice.</p>

    <div style="margin-top:36px;padding:22px 24px;background:var(--soft);border-radius:12px;">
      <h2 style="font-size:20px;margin-bottom:10px;">Put the licence number on the document</h2>
      <p style="font-size:15px;line-height:1.65;">Every template on this site has a licence field in the header, so the number prints next to your business name on PDF, Word and Excel versions. Start with the trade you work in:</p>
      <p style="font-size:15px;line-height:1.9;margin-top:10px;">
        <a href="/templates/electrician-invoice-template/" style="color:var(--accent);font-weight:600;">Electrician invoice</a> ·
        <a href="/templates/plumbing-invoice-template/" style="color:var(--accent);font-weight:600;">Plumbing invoice</a> ·
        <a href="/templates/hvac-invoice-template/" style="color:var(--accent);font-weight:600;">HVAC invoice</a> ·
        <a href="/templates/roofer-invoice-template/" style="color:var(--accent);font-weight:600;">Roofing invoice</a> ·
        <a href="/templates/drywall-invoice-template/" style="color:var(--accent);font-weight:600;">Drywall invoice</a> ·
        <a href="/templates/pest-control-invoice-template/" style="color:var(--accent);font-weight:600;">Pest control invoice</a> ·
        <a href="/templates/general-contractor-invoice-template/" style="color:var(--accent);font-weight:600;">General contractor invoice</a>
      </p>
    </div>
  </section>

  <section class="section wrap" style="padding-top:36px;">
    <div class="section-head">
      <h2>Licence questions contractors ask</h2>
    </div>
    <div style="margin-top:20px;">
      {faqs.map((f) => (
        <details style="margin-bottom:12px;border:1px solid var(--line);border-radius:8px;padding:16px 20px;background:var(--surface);">
          <summary style="font-weight:700;cursor:pointer;">{f.q}</summary>
          <p style="margin-top:10px;color:var(--muted);">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="section wrap" style="padding-top:20px;padding-bottom:60px;">
    <div style="padding:20px 24px;background:var(--soft);border-radius:12px;">
      <p style="font-size:15px;line-height:1.7;margin:0;"><strong>Cite or reuse this table:</strong> the data above is free to quote with a link to this page. If you maintain a resource list for contractors, link to <a href={canonical} style="color:var(--accent);font-weight:600;">fieldformtemplates.com/contractor-license-requirements-by-state/</a> — we keep it updated as state rules change.</p>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  })} />
</BaseLayout>
