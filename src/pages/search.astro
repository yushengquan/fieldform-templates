---
// /search?q= — 客户端搜索页，支撑 WebSite SearchAction schema (sitelinks search box)
import BaseLayout from '../layouts/BaseLayout.astro';

const modules = import.meta.glob('../data/trades/*.json', { eager: true });
const trades = Object.values(modules).map((m: any) => m.default).map((t: any) => ({
  slug: t.slug,
  title: t.title,
  trade: t.trade,
  docType: t.docType,
  subtitle: t.subtitle,
}));

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://fieldformtemplates.com';

const breadcrumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
    { "@type": "ListItem", position: 2, name: "Search", item: `${siteUrl}/search` },
  ],
});
---
<BaseLayout
  title="Search Templates — FieldForm Templates"
  description="Search all invoice and estimate templates by trade or document type."
  canonical={`${siteUrl}/search`}
>
  <script is:inline type="application/ld+json" set:html={breadcrumbLd}></script>

  <section class="section wrap" style="padding-top:56px;">
    <div class="section-head">
      <h1>Search templates</h1>
      <p class="lead">Find the right invoice or estimate template for your trade.</p>
    </div>
    <div style="margin-bottom:24px;">
      <input
        id="search-input"
        type="search"
        placeholder="e.g. plumbing, electrician, estimate…"
        style="width:100%;max-width:480px;padding:12px 16px;font-size:16px;border:1px solid var(--line);border-radius:8px;outline:none;"
        autofocus
      />
    </div>
    <p id="result-count" style="font-size:14px;color:var(--muted);margin-bottom:20px;"></p>
    <div id="results" class="grid2"></div>
    <div id="no-results" style="display:none;padding:40px 0;text-align:center;color:var(--muted);">
      <p style="font-size:18px;">No templates found. Try a different trade name.</p>
      <p style="margin-top:8px;"><a href="/" style="color:var(--blue);">Browse all templates →</a></p>
    </div>
  </section>

  <script is:inline define:vars={{ trades }}>
    const input = document.getElementById('search-input');
    const results = document.getElementById('results');
    const count = document.getElementById('result-count');
    const noResults = document.getElementById('no-results');

    function render(q) {
      const query = q.toLowerCase().trim();
      const filtered = query
        ? trades.filter(t =>
            t.title.toLowerCase().includes(query) ||
            t.trade.toLowerCase().includes(query) ||
            t.docType.toLowerCase().includes(query) ||
            t.slug.includes(query.replace(/\s+/g, '-'))
          )
        : trades;

      count.textContent = filtered.length + ' template' + (filtered.length !== 1 ? 's' : '') + (query ? ' for "' + q + '"' : ' total');

      if (filtered.length === 0) {
        results.innerHTML = '';
        noResults.style.display = 'block';
        return;
      }
      noResults.style.display = 'none';
      results.innerHTML = filtered.map(t =>
        '<a class="tpl-card" href="/templates/' + t.slug + '/">' +
          '<span class="tag">' + t.trade + '</span>' +
          '<h3>' + t.title + '</h3>' +
          '<p>' + t.subtitle + '</p>' +
          '<span class="go">View & download →</span>' +
        '</a>'
      ).join('');
    }

    // Read ?q= on load
    const params = new URLSearchParams(window.location.search);
    const initialQ = params.get('q') || '';
    input.value = initialQ;
    render(initialQ);

    input.addEventListener('input', (e) => {
      render(e.target.value);
      const url = new URL(window.location);
      if (e.target.value) url.searchParams.set('q', e.target.value);
      else url.searchParams.delete('q');
      window.history.replaceState({}, '', url);
    });
  </script>
</BaseLayout>