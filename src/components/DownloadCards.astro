---
// 下载卡片：PDF / Word / Excel 全部免邮箱直链下载（MVP 阶段；未来流量起来后再上留资墙）
interface Props {
  slug: string;
  downloads: any;
  active?: string;
}
const { slug, downloads, active } = Astro.props;
const order = ["pdf", "word", "excel"];
const ext: Record<string, string> = { pdf: "pdf", word: "docx", excel: "xlsx" };
const btnCls: Record<string, string> = { pdf: "btn-primary", word: "btn-ghost", excel: "btn-teal" };
const meta: Record<string, { cls: string; icon: string }> = {
  pdf: { cls: "tag-blue", icon: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0l-4-4m4 4l4-4"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>' },
  word: { cls: "tag-gray", icon: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4"/></svg>' },
  excel: { cls: "tag-teal", icon: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M4 10h16M4 15h16M10 3v18"/></svg>' },
};
const activeNote: Record<string, string> = {
  word: "This is the Word version you searched for — download it below.",
  excel: "This is the Excel version you searched for — download it below.",
};
---
<div class="dl-grid">
  {order.map((key) => {
    const d = downloads?.[key];
    if (!d) return null;
    const m = meta[key];
    const isActive = active === key;
    return (
      <div class="dl-card" style={isActive ? "border-color:var(--teal);box-shadow:0 4px 14px rgba(20,155,140,.15);" : ""}>
        {isActive && <span style="display:block;font-size:12px;font-weight:700;color:var(--teal);margin-bottom:8px;">✓ {activeNote[key]}</span>}
        <span class={`tag ${m.cls}`} set:html={m.icon + "Free download"}></span>
        <h3>{d.label}</h3>
        <p>{d.note}</p>
        <a class={`btn btn-block ${btnCls[key]}`} href={`/downloads/${slug}.${ext[key]}`} download
           onclick={`if(window.gtag)gtag('event','download',{file_format:'${key}',template:'${slug}'});`}>
          Download {d.label}
        </a>
      </div>
    );
  })}
</div>

