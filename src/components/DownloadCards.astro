---
// 下载卡片：PDF 免费直接下（护 SEO）；Word/Excel 邮箱换下载（FormSubmit 过渡方案，未来迁 Brevo）
interface Props {
  slug: string;
  downloads: any;
  active?: string;
}
const { slug, downloads, active } = Astro.props;
const order = ["pdf", "word", "excel"];
const ext: Record<string, string> = { pdf: "pdf", word: "docx", excel: "xlsx" };
const btnCls: Record<string, string> = { pdf: "btn-primary", word: "btn-ghost", excel: "btn-teal" };
const meta: Record<string, { cls: string; icon: string }> = {
  pdf: { cls: "tag-blue", icon: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0l-4-4m4 4l4-4"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>' },
  word: { cls: "tag-gray", icon: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4"/></svg>' },
  excel: { cls: "tag-teal", icon: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M4 10h16M4 15h16M10 3v18"/></svg>' },
};
const activeNote: Record<string, string> = {
  word: "This is the Word version you searched for — download it below.",
  excel: "This is the Excel version you searched for — download it below.",
};
---
<div class="dl-grid">
  {order.map((key) => {
    const d = downloads?.[key];
    if (!d) return null;
    const m = meta[key];
    const isActive = active === key;
    const downloadUrl = `/downloads/${slug}.${ext[key]}`;
    return (
      <div class="dl-card" style={isActive ? "border-color:var(--teal);box-shadow:0 4px 14px rgba(20,155,140,.15);" : ""}>
        {isActive && <span style="display:block;font-size:12px;font-weight:700;color:var(--teal);margin-bottom:8px;">✓ {activeNote[key]}</span>}
        <span class={`tag ${m.cls}`} set:html={m.icon + "Free download"}></span>
        <h3>{d.label}</h3>
        <p>{d.note}</p>

        {key === "pdf" ? (
          <a class="btn btn-block btn-primary" href={downloadUrl} download
             onclick={`if(window.gtag)gtag('event','download',{file_format:'pdf',template:'${slug}'});`}>
            Download PDF
          </a>
        ) : (
          <div class="gate">
            <button class={`btn btn-block ${btnCls[key]} gate-open`} type="button" data-gate-open={key}>
              Get {d.label}
            </button>
            <form class="gate-form" data-gate-form={key} hidden>
              <input class="gate-email" type="email" name="email" placeholder="Email to get the download link" required />
              <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
              <button class="btn btn-block btn-primary" type="submit">Send me the link</button>
              <p class="gate-msg" data-gate-msg={key}></p>
            </form>
            <a class={`btn btn-block ${btnCls[key]} gate-ready`} href={downloadUrl} download
               data-gate-ready={key} hidden
               onclick={`if(window.gtag)gtag('event','download',{file_format:'${key}',template:'${slug}'});`}>
              Download {d.label}
            </a>
          </div>
        )}
      </div>
    );
  })}
</div>

<script define:vars={{ slug }}>
  document.querySelectorAll("[data-gate-open]").forEach((btn) => {
    btn.addEventListener("click", () => {
      btn.hidden = true;
      const form = btn.parentElement.querySelector("[data-gate-form]");
      if (form) form.hidden = false;
    });
  });

  document.querySelectorAll("[data-gate-form]").forEach((form) => {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fmt = form.getAttribute("data-gate-form");
      const msg = form.querySelector("[data-gate-msg]");
      const emailInput = form.querySelector('input[name="email"]');
      const email = emailInput.value.trim();
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
        msg.textContent = "Please enter a valid email address.";
        return;
      }
      msg.textContent = "Sending…";
      try {
        const res = await fetch("https://formsubmit.co/ajax/yushengquanem@163.com", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({
            email: email,
            template: slug,
            format: fmt,
            _subject: "FieldForm template download: " + slug + " (" + fmt + ")",
            _template: "table",
            _captcha: "false",
          }),
        });
        const data = await res.json();
        if (data.success === "true" || data.success === true) {
          msg.textContent = "✓ Download ready below — click the button.";
          form.hidden = true;
          const ready = form.parentElement.querySelector("[data-gate-ready]");
          if (ready) ready.hidden = false;
          if (window.gtag) gtag("event", "lead", { template: slug, format: fmt });
        } else {
          msg.textContent = (data && data.message) ? data.message : "Something went wrong — please try again.";
        }
      } catch (err) {
        msg.textContent = "Network error — please try again.";
      }
    });
  });
</script>

<style>
  .gate-email {
    width: 100%;
    padding: 10px 12px;
    margin-bottom: 8px;
    border: 1px solid var(--line);
    border-radius: 8px;
    font-size: 14px;
    font-family: inherit;
    box-sizing: border-box;
    color: var(--ink);
    background: #fff;
  }
  .gate-email:focus { outline: none; border-color: var(--accent); }
  .gate-msg { font-size: 13px; color: var(--muted); margin: 8px 0 0; min-height: 16px; }
</style>
