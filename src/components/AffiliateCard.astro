---
// 联盟推荐卡：按工种推荐对应的开票/管理 SaaS，转化后拿佣金。
// ⚠️ 上线步骤：把下面 AFFILIATE 里 url 的 YOUR_ID 占位换成你真实的联盟 ID/链接即可全站生效。
interface Props {
  trade: string;
  docType?: string;
}
const { trade, docType } = Astro.props;

// 联盟链接占位 —— 拿到真实联盟 ID 后替换 url 字段即可全站生效。
const AFFILIATE = {
  jobber: {
    tool: "Jobber",
    url: "https://getjobber.com/?ref=YOUR_ID",
    tagline: "Scheduling, quotes, invoices, and payments in one app — built for home-service pros.",
  },
  quickbooks: {
    tool: "QuickBooks",
    url: "https://quickbooks.intuit.com/?ref=YOUR_ID",
    tagline: "Track income, send invoices, and run reports — accounting built for self-employed trades.",
  },
  square: {
    tool: "Square Invoices",
    url: "https://squareup.com/invoices?ref=YOUR_ID",
    tagline: "Send free invoices and get paid online by card — no monthly fee.",
  },
};

// 按工种选最贴合的工具
const t = (trade ?? "").toLowerCase();
let pick = AFFILIATE.jobber; // 默认：现场服务管理，适合大多数手艺人
if (/(freelance|tutor|personal trainer|photographer|salon|consult)/.test(t)) {
  pick = AFFILIATE.quickbooks; // 知识/服务类 → 记账
}
---
<aside class="affiliate-card">
  <div class="aff-inner">
    <div class="aff-text">
      <p class="aff-kicker">Save time on every job</p>
      <h3>Tired of hand-writing {docType ?? "invoices"}?</h3>
      <p class="aff-body">{pick.tagline}</p>
    </div>
    <a class="aff-cta" href={pick.url} target="_blank" rel="nofollow sponsored noopener">
      Try {pick.tool} &rarr;
    </a>
  </div>
  <p class="aff-disclosure">We may earn a commission if you sign up through this link — at no extra cost to you.</p>
</aside>

<style>
.affiliate-card {
  border: 1px solid #e2e8f0;
  border-radius: 14px;
  background: linear-gradient(135deg, #f8fafc, #eef4fb);
  padding: 22px 24px;
  margin: 0 auto;
  max-width: 720px;
}
.aff-inner { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
.aff-kicker { font-size: 12px; font-weight: 700; letter-spacing: .5px; color: #0e7c66; text-transform: uppercase; margin: 0 0 6px; }
.aff-text h3 { margin: 0 0 6px; font-size: 20px; color: #0f172a; }
.aff-body { margin: 0; color: #475569; font-size: 15px; max-width: 460px; }
.aff-cta {
  display: inline-block; background: #1668D4; color: #fff; font-weight: 700;
  padding: 12px 22px; border-radius: 9px; text-decoration: none; white-space: nowrap;
  transition: background .15s;
}
.aff-cta:hover { background: #0f4fa3; }
.aff-disclosure { margin: 12px 0 0; font-size: 11px; color: #94a3b8; }
</style>