---
// 发票/估价单预览组件：用 CSS 渲染一张"纸面单据"示意，数据来自模板配置
interface Props {
  trade: any;
}
const { trade } = Astro.props;
const dt = trade.docType;
const isEst = dt === "estimate" || dt === "quote";
const isCredit = dt === "credit-note";
const isWorkOrder = dt === "work-order";
const isDelivery = dt === "delivery-note";
const docNo = dt === "quote" ? "Quote #: QUOTE-0001" : "Estimate #: EST-0001";
const items = trade.lineItems ?? [];

// 日期：构建时动态计算,不再硬编码。每次部署日期自动更新。
const now = new Date();
const todayStr = now.toISOString().slice(0, 10);
const plusDays = (n: number) => {
  const d = new Date(now);
  d.setDate(d.getDate() + n);
  return d.toISOString().slice(0, 10);
};
const validUntil = plusDays(30);  // 估价有效期 30 天
const dueDate = plusDays(14);      // 发票到期 14 天(Net 14)
let subtotal = 0;
const rows = items.map((it: any, i: number) => {
  const amount = (it.defaultQty ?? 0) * (it.sampleRate ?? 0);
  subtotal += amount;
  return { ...it, i: i + 1, amount };
});
const fmt = (n: number) => "$" + n.toFixed(2);
const depPct = trade.depositPct ?? 25;
const totalItems = rows.reduce((a: number, r: any) => a + (r.defaultQty ?? 0), 0);
---
<div class="preview-band">
  <div class="paper">
    <h4>{trade.title?.toUpperCase()}</h4>
    <div class="paper-grid">
      <div>
        <div class="lbl">From</div>
        <div>Your Business Name<br>Street Address, City, State ZIP<br>Phone | Email</div>
        <div style="margin-top:8px;">{trade.licenseField !== false && <>License #: ________<br></>}EIN / Tax ID: ________</div>
      </div>
      <div>
        <div class="lbl">Bill To</div>
        <div>Client Name<br>Client Address<br>Job Site Address</div>
        {isEst ? (
          <div style="margin-top:8px;">{docNo}<br>Date: {todayStr} · Valid Until: {validUntil}<br>Terms: Net 14</div>
        ) : isCredit ? (
          <div style="margin-top:8px;">Credit Note #: CN-0001<br>Date: {todayStr} · Original Invoice #: INV-______<br>Terms: Net 14</div>
        ) : isWorkOrder ? (
          <div style="margin-top:8px;">Work Order #: WO-0001<br>Date: {todayStr} · Service Date: ________<br>Terms: Net 14</div>
        ) : isDelivery ? (
          <div style="margin-top:8px;">Delivery Note #: DN-0001<br>Date: {todayStr} · PO #: ________<br>Delivered By: ________</div>
        ) : (
          <div style="margin-top:8px;">Invoice #: INV-0001<br>Date: {todayStr} · Terms: Net 14<br>Due: {dueDate}</div>
        )}
      </div>
    </div>
    <table class="paper-table">
      <tr><th style="width:8%">#</th><th style="width:52%">Description</th><th style="width:9%">Qty</th><th style="width:11%">Unit</th><th style="width:10%">Rate</th><th style="width:10%">Amount</th></tr>
      {rows.map((r: any) => (
        <tr>
          <td>{r.i}</td>
          <td>{r.description}</td>
          <td class="num">{r.defaultQty}</td>
          <td>{r.unit}</td>
          <td class="num">{fmt(r.sampleRate)}</td>
          <td class="num">{fmt(r.amount)}</td>
        </tr>
      ))}
    </table>
    <div class="paper-totals">
      {isEst ? (
        <>
          <span>SUBTOTAL</span><span class="num">{fmt(subtotal)}</span>
          <span>DEPOSIT DUE ({depPct}%)</span><span class="num">{fmt(subtotal * depPct / 100)}</span>
          <span class="big">BALANCE DUE</span><span class="big num">{fmt(subtotal * (100 - depPct) / 100)}</span>
        </>
      ) : isCredit ? (
        <>
          <span>SUBTOTAL</span><span class="num">{fmt(subtotal)}</span>
          <span>TAX RATE</span><span class="num">(enter state rate)</span>
          <span class="big">TOTAL CREDIT</span><span class="big num">{fmt(subtotal)}</span>
        </>
      ) : isWorkOrder ? (
        <>
          <span>SUBTOTAL</span><span class="num">{fmt(subtotal)}</span>
          <span>DEPOSIT DUE ({depPct}%)</span><span class="num">{fmt(subtotal * depPct / 100)}</span>
          <span class="big">BALANCE DUE</span><span class="big num">{fmt(subtotal * (100 - depPct) / 100)}</span>
        </>
      ) : isDelivery ? (
        <>
          <span>TOTAL ITEMS</span><span class="num">{totalItems}</span>
          <span>GOODS VALUE</span><span class="num">{fmt(subtotal)}</span>
          <span class="big">RECEIVED BY</span><span class="big num">_______________</span>
        </>
      ) : (
        <>
          <span>SUBTOTAL</span><span class="num">{fmt(subtotal)}</span>
          <span>TAX RATE</span><span class="num">(enter state rate)</span>
          <span>TAX</span><span class="num">—</span>
          <span class="big">TOTAL DUE</span><span class="big num">{fmt(subtotal)}</span>
        </>
      )}
    </div>
    <div class="paper-note">
      {isEst ? (dt === "quote" ? "This is a quote — not an invoice. Pricing valid for 30 days. " : "This is an estimate — not a final invoice. Final charges may vary based on actual work performed. ") : isCredit ? "This is a credit note — it reduces the balance of the original invoice. " : isWorkOrder ? "This is a work order — signed authorization to perform the work; final totals are billed on completion. " : isDelivery ? "This is a delivery note — proof of delivery only, not a bill for payment. " : ""}
      Payment terms: {trade.paymentTerms} {trade.notes ? trade.notes + " " : ""}
      {trade.disclaimer}
    </div>
  </div>
</div>
