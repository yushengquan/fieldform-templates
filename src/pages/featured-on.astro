const listLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  url: `${siteUrl}/featured-on/`,
  name: "Where FieldForm Templates is featured",
  description:
    "Directories, launch platforms and tool catalogues where FieldForm Templates has been listed.",
  isPartOf: { "@type": "WebSite", name: "FieldForm Templates", url: siteUrl },
});

const breadcrumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
    { "@type": "ListItem", position: 2, name: "Featured on", item: `${siteUrl}/featured-on/` },
  ],
});
---
<BaseLayout
  title="Where FieldForm Templates Is Featured — Directories & Launch Platforms"
  description="Directories, launch platforms and tool catalogues where FieldForm Templates, the free library of trade-specific invoice and estimate templates, has been listed."
  canonical={`${siteUrl}/featured-on/`}
>
  <script is:inline type="application/ld+json" set:html={listLd}></script>
  <script is:inline type="application/ld+json" set:html={breadcrumbLd}></script>

  <section class="section wrap" style="padding-top:56px;">
    <div class="section-head">
      <p style="font-size:13px;font-weight:700;letter-spacing:.4px;color:var(--teal);text-transform:uppercase;margin-bottom:10px;">Featured on</p>
      <h1>Where FieldForm Templates is listed</h1>
      <p class="lead">
        FieldForm Templates is a free library of trade-specific invoice, estimate and business-form
        templates for contractors and service businesses. Below are the directories, launch platforms
        and tool catalogues where it has been listed.
      </p>
    </div>
  </section>

  <section class="section wrap" style="padding-top:8px;">
    <div class="grid3">
      {
        badges.map((b) => (
          <div class="card">
            <h3 style="margin-bottom:6px;">{b.name}</h3>
            <p style="margin-bottom:12px;">{b.note}</p>
            <a href={b.url} target="_blank" rel={b.dofollow ? 'dofollow noopener' : 'noopener'} aria-label={`View ${b.name} listing`}>
              {b.img ? (
                <img
                  src={b.img}
                  alt={`Featured on ${b.name}`}
                  width={b.w}
                  height={b.h}
                  loading="lazy"
                />
              ) : (
                <span style={{ display: 'inline-block', fontWeight: 700, fontSize: '16px', color: 'var(--blue)', padding: '10px 18px', border: '2px solid var(--line)', borderRadius: '8px' }}>
                  {b.text}
                </span>
              )}
            </a>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section wrap" style="padding-top:8px;">
    <div class="card" style="display:flex;flex-wrap:wrap;align-items:center;gap:16px;">
      <div style="flex:1 1 260px;">
        <h3 style="margin-bottom:6px;">Reviewed by launched.tools</h3>
        <p style="margin:0;">
          Every listing on <a href="https://launched.tools" target="_blank" rel="noopener">launched.tools</a>
          is test-driven and scored out of 100 before it is accepted.
        </p>
      </div>
      <div style="flex:0 0 auto;">
        <a href="https://launched.tools/tools/fieldform-templates" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:8px;background:transparent;border:1px solid #D4D7C9;border-radius:10px;padding:8px 12px;text-decoration:none;font-family:sans-serif">
          <span style="width:22px;height:22px;border-radius:6px;background:#C6F94E;display:inline-flex;align-items:center;justify-content:center">
            <svg width="13" height="13" viewBox="128 120 264 264"><path d="M214 120 L392 120 L392 298 Z" fill="#15170F"></path><path d="M156 356 L322 190" stroke="#15170F" stroke-width="78" fill="none"></path></svg>
          </span>
          <span style="display:flex;flex-direction:column;line-height:1.2">
            <span style="font-weight:700;font-size:12px;color:inherit">Featured on launched.tools</span>
            <span style="font-size:10px;color:#878C79">REVIEWED ✓</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="section wrap" style="padding-top:8px;padding-bottom:48px;">
    <div class="card">
      <h3 style="margin-bottom:8px;">About FieldForm Templates</h3>
      <p>
        FieldForm Templates publishes free, downloadable invoice and estimate templates for more than
        50 trades, including plumbing, HVAC, electrical, roofing, cleaning, landscaping, concrete and
        welding. Every template is available as a print-ready PDF, an editable Word file and an Excel
        workbook with live formulas for subtotal, tax and total. No email address, signup or watermark
        is required.
      </p>
      <p style="margin-top:12px;">
        Start browsing: <a href="/invoice-templates/">invoice templates</a> ·
        <a href="/estimate-templates/">estimate templates</a> ·
        <a href="/business-form-templates/">business forms</a>
      </p>
    </div>
  </section>
</BaseLayout>