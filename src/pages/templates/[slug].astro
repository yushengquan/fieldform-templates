---
// 动态模板页：/templates/[slug]/ — 从 data/trades/*.json 批量生成
// 每个工种生成 3 个变体：主页面 + Word 版 + Excel 版（格式长尾页，各自独立 SEO）
import BaseLayout from '../../layouts/BaseLayout.astro';
import InvoicePreview from '../../components/InvoicePreview.astro';
import DownloadCards from '../../components/DownloadCards.astro';
import FaqList from '../../components/FaqList.astro';
import InvoiceBuilder from '../../components/InvoiceBuilder.astro';
import { howToUseParagraph, howToUseCards, billingContext, tradePerson } from '../../lib/how-to-use';

export function getStaticPaths() {
  const modules = import.meta.glob('../../data/trades/*.json', { eager: true });
  const trades: any[] = Object.values(modules).map((m: any) => m.default);
  const paths: any[] = [];
  for (const t of trades) {
    paths.push({ params: { slug: t.slug }, props: { trade: t, format: '' } });
    paths.push({ params: { slug: t.slug + '-word' }, props: { trade: t, format: 'word' } });
    paths.push({ params: { slug: t.slug + '-excel' }, props: { trade: t, format: 'excel' } });
  }
  return paths;
}

const { trade, format } = Astro.props;
const items = trade.lineItems ?? [];
let subtotal = 0;
for (const it of items) subtotal += (it.defaultQty ?? 0) * (it.sampleRate ?? 0);

// —— 通用单据页文案覆盖机制 ——
// 新 docType（credit-note / work-order / delivery-note 等）或非工种页面，lib 自动文案不适配时，
// 在 trade JSON 里加 "overrides": {...} 改写对应文案；旧 JSON 无该字段 → 全部回退原逻辑，输出不变。
const ov = trade.overrides ?? {};
// 眉题源文本词组首字母大写（视觉层由 CSS uppercase 覆盖，此改动惠及复制/读屏器/无 CSS 场景）
const capWords = (s: string) => s.split('-').map((w: string) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
const eyebrowText = ov.eyebrow ?? `${trade.trade} · ${capWords(trade.docType)} Template`;
const docSynonym = ov.docSynonym ?? (trade.docType === 'invoice' ? 'invoice (bill)' : trade.docType);
const hubHref = ov.hubHref ?? `/${trade.docType === 'invoice' ? 'invoice' : 'estimate'}-templates/`;
const hubLabel = ov.hubLabel ?? (trade.docType === 'invoice' ? 'Invoice Templates' : 'Estimate Templates');
const previewAlt = ov.previewAlt ?? `${trade.title} preview — pre-filled ${trade.trade} ${trade.docType} with auto-calculating totals`;
const featuresSub = ov.featuresSub ?? `Built for the way a ${trade.trade} business bills a job.`;
const billingHeading = ov.billingHeading ?? `How ${tradePerson(trade.trade)} typically bill`;
const billingSub = ov.billingSub ?? `Industry norms for pricing ${trade.docType === 'invoice' ? 'a job' : 'a quote'} — so your numbers look right to the customer.`;
const relatedSub = ov.relatedSub ?? 'Same trade, same paperwork — pick the document that fits the job.';

// 内部链接：同工种其他单据 + 同类型单据的其他工种（pSEO 权重流动 + 全站爬取）
const allTrades: any[] = Object.values(import.meta.glob('../../data/trades/*.json', { eager: true })).map((m: any) => m.default);
// 工种家族归一 — 同一用户意图的工种合并成一个集群，同族页面互链：
// Welder/Welding 4 页老集群；Metal Fabrication Shop 归入焊接集群（fabrication ↔ welding 互链）；
// Window Tinting Installer 与 Boat Detailing Service 归入 Auto Detailing 集群（汽车美容 ↔ 贴膜/船舶美化互链）
const famMap: Record<string, string> = {
  'Welder': 'Welding',
  'Metal Fabrication Shop': 'Welding',
  'Window Tinting Installer': 'Auto Detailing',
  'Boat Detailing Service': 'Auto Detailing',
  // 建筑类工种合并集群：drywall/roofer/concrete/gutter 同一采购意图（GC 分包报价），互相导流
  'Drywall Contractor': 'Construction',
  'Roofer': 'Construction',
  'Concrete Contractor': 'Construction',
  'Gutter Service': 'Construction',
};
const fam = (t: any) => famMap[t.trade] ?? t.trade;
const sameTradeRel = allTrades.filter((t: any) => fam(t) === fam(trade) && t.slug !== trade.slug);
const sameDocRel = allTrades.filter((t: any) => t.docType === trade.docType && fam(t) !== fam(trade));
// 确定性轮转：按页面 slug 哈希偏移同类型工种列表 — 55 个工种都能分到内链，而不是全站都链字母序前 6 个
const rotOff = [...trade.slug].reduce((a, c) => a + c.charCodeAt(0), 0) % Math.max(sameDocRel.length, 1);
const docRotated = sameDocRel.length ? [...sameDocRel.slice(rotOff), ...sameDocRel.slice(0, rotOff)] : [];
// 通用单据页可用 overrides.relatedSlugs 指定相关模板（新 docType 没有同族页面时）
const related = ov.relatedSlugs
  ? allTrades.filter((t: any) => (ov.relatedSlugs as string[]).includes(t.slug))
      .sort((a: any, b: any) => (ov.relatedSlugs as string[]).indexOf(a.slug) - (ov.relatedSlugs as string[]).indexOf(b.slug))
  : [...sameTradeRel, ...docRotated].slice(0, 6);

// 跨工種熱門推薦 — 把高流量頁面（含 tiling-estimate）從每個模板頁面串起來
// GSC 数据驱动：pest-control-invoice(57 impr)、locksmith-invoice(54)、electrical-estimate(41)、
// carpentry-invoice(32)、hvac-invoice(27)、hvac-estimate(17)、pressure-washing-estimate(14)、
// plumbing-invoice(12)、contractor-estimate(12) — 全部进全站内链池
const popularSlugs = ['pest-control-invoice-template', 'electrician-invoice-template', 'tiling-estimate-template', 'hvac-invoice-template', 'locksmith-invoice-template', 'electrician-estimate-template', 'carpenter-invoice-template', 'hvac-estimate-template', 'plumbing-invoice-template', 'pressure-washing-estimate-template', 'general-contractor-estimate-template', 'welding-estimate-template', 'welding-quote-template'];
const popular = allTrades.filter((t: any) => popularSlugs.includes(t.slug) && t.slug !== trade.slug);

// 第二内链池 — GSC 数据驱动：位置 15–45、已有真实曝光、但入站内链只有 12–27 个的页面
// （热门页 207 个入站内链 → 位置差 20–60 名）。紧凑文字链接块，全站分发。
// 10/27 首批 6 个；10/28 加入 fabrication(15.3，已产生点击) 与 window-cleaning(变体点击)
const risingSlugs = ['gutter-invoice-template', 'drywall-invoice-template', 'roofer-estimate-template', 'concrete-invoice-template', 'locksmith-estimate-template', 'salon-invoice-template', 'fabrication-invoice-template', 'window-cleaning-invoice-template'];
const rising = allTrades.filter((t: any) => risingSlugs.includes(t.slug) && t.slug !== trade.slug);

// 在线发票生成器（工具闭环）— 先上位置最好的 3 个主页面，验证交互信号后再扩
const builderSlugs = ['pest-control-invoice-template', 'hvac-invoice-template', 'drywall-invoice-template'];

// 反向查找：是否有对应 guide 页指向此模板（含 altTemplateSlugs — 一个 guide 服务多个同族模板页）
const allGuides: any[] = Object.values(import.meta.glob('../../data/guides/*.json', { eager: true })).map((m: any) => m.default);
const linkedGuide = allGuides.find((g: any) => g.templateSlug === trade.slug || (g.altTemplateSlugs ?? []).includes(trade.slug));

const fmtLabel = format === 'word' ? 'Word' : format === 'excel' ? 'Excel' : '';
const fmtPhrase = format === 'word' ? 'Word Format' : format === 'excel' ? 'Excel Format' : '';
// Word/Excel 变体页 title 加入 "Bill Format" 同义词 — 用户高频搜 "bill format" 而非 "invoice template"
const billSynonym = trade.docType === 'invoice' ? ' (Bill Format)' : '';
const pageTitle = format
  ? `${trade.title}${billSynonym} — Free ${fmtLabel} Download`
  : `${trade.title} — Free PDF, Word & Excel`;
const pageDesc = format
  ? `Download a free ${trade.trade} ${docSynonym} template in ${fmtLabel} format. Editable, printable, no email required. Pre-filled with ${trade.trade} line items and auto-calculating totals.`
  : trade.subtitle;
const firstItem = items[0] ?? { code: 'ITEM', description: 'your first line item' };
const exampleItem = `${firstItem.description} (${firstItem.code})`;

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: (trade.faqs ?? []).map((f: any) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
});

// 面包屑结构化数据 → 搜索富摘要（提升点击率）
const siteUrl = Astro.site?.toString() ?? 'https://fieldformtemplates.com';
const breadcrumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
    { "@type": "ListItem", position: 2, name: trade.title, item: `${siteUrl}templates/${trade.slug}/` },
  ],
});

// Product schema → 免费数字产品富摘要（Google Merchant Listings 认 Product 类型，显示 $0 价格标签）
const appLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Product",
  name: trade.title,
  description: trade.subtitle,
  category: "Business Template",
  image: `${siteUrl}og/${trade.slug}.png`,
  isAccessibleForFree: true,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
    url: `${siteUrl}templates/${trade.slug}/`,
    hasMerchantReturnPolicy: {
      "@type": "MerchantReturnPolicy",
      applicableCountry: "US",
      returnPolicyCategory: "https://schema.org/MerchantReturnNotPermitted",
      merchantReturnDays: 0,
      description: "Free digital download — no physical item shipped, no return applicable.",
    },
    shippingDetails: {
      "@type": "OfferShippingDetails",
      shippingRate: {
        "@type": "MonetaryAmount",
        value: "0",
        currency: "USD",
      },
      shippingDestination: {
        "@type": "DefinedRegion",
        addressCountry: "US",
      },
      deliveryTime: {
        "@type": "ShippingDeliveryTime",
        handlingTime: {
          "@type": "QuantitativeValue",
          minValue: 0,
          maxValue: 0,
          unitCode: "DAY",
        },
        transitTime: {
          "@type": "QuantitativeValue",
          minValue: 0,
          maxValue: 0,
          unitCode: "DAY",
        },
      },
      description: "Instant digital download — no shipping required.",
    },
  },
  brand: { "@type": "Brand", name: "FieldForm Templates" },
});

// 独特正文段落 —— 从 trade 字段自动生成,避免 156 个模板页内容雷同被判定 thin content
// 通用单据页可在 JSON overrides 里提供 howToUseText / howToUseSteps / billingText
const howToUseText = ov.howToUseText ?? howToUseParagraph(trade);
const howToUseSteps = ov.howToUseSteps ?? howToUseCards(trade);
const billingText = ov.billingText ?? billingContext(trade);

// HowTo schema → 富摘要机会(逐步说明 + 总耗时)
const howToLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: `How to use ${trade.title}`,
  description: howToUseText.slice(0, 200),
  step: howToUseSteps.map((s: any) => ({
    "@type": "HowToStep",
    name: s.title,
    text: s.body,
  })),
});
---
<BaseLayout title={pageTitle} description={pageDesc} ogImage={`/og/${trade.slug}.png`}>
  <script is:inline type="application/ld+json" set:html={jsonLd}></script>
  <script is:inline type="application/ld+json" set:html={breadcrumbLd}></script>
  <script is:inline type="application/ld+json" set:html={appLd}></script>
  <script is:inline type="application/ld+json" set:html={howToLd}></script>

  <section class="section wrap" style="padding-top:56px;">
    <nav class="breadcrumbs" aria-label="Breadcrumb" style="font-size:13px;color:var(--muted);margin-bottom:16px;">
      <a href="/" style="color:var(--muted);">Home</a>
      <span style="margin:0 6px;">/</span>
      <a href={hubHref} style="color:var(--muted);">{hubLabel}</a>
      <span style="margin:0 6px;">/</span>
      <span style="color:var(--ink);font-weight:600;">{pageTitle.split(' — ')[0]}</span>
    </nav>
    <div class="section-head">
      <p style="font-size:13px;font-weight:700;letter-spacing:.4px;color:var(--teal);text-transform:uppercase;margin-bottom:10px;">{eyebrowText}{format ? ` · ${fmtLabel} format` : ''}</p>
      <h1>{format ? `${trade.title} (${fmtLabel})` : trade.title}</h1>
      <p class="lead">{pageDesc}</p>
    </div>
    {/* 跨單據類型醒目內鏈 — 用戶搜 "estimate" 卻落到 invoice 頁時,一眼看到正確去向 */}
    {!format && sameTradeRel.length > 0 && (
      <div style="margin-top:20px;padding:14px 20px;background:linear-gradient(135deg,#f0f7ff,#e8f4fe);border:1px solid #b8d8f5;border-radius:10px;display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
        <span style="font-size:16px;">💡</span>
        <span style="font-size:15px;color:var(--ink);">Looking for a <strong>{trade.trade} {sameTradeRel[0].docType}</strong> instead?</span>
        <a href={`/templates/${sameTradeRel[0].slug}/`} style="font-size:15px;font-weight:700;color:var(--blue);text-decoration:underline;">→ {sameTradeRel[0].title}</a>
      </div>
    )}
  </section>

  <section class="section wrap" id="download" style="padding-top:8px;">
    <DownloadCards slug={trade.slug} downloads={trade.downloads} active={format || undefined} />

    {/* 变体页三角互链 — 消除 orphan page,让 Word/Excel 变体页获得内链权重 */}
    {!format && (
      <div class="variant-links" style="margin-top:24px;padding:16px 20px;background:var(--surface);border:1px solid var(--line);border-radius:12px;">
        <p style="font-size:14px;font-weight:700;margin-bottom:10px;">Looking for a specific format?</p>
        <p style="font-size:14px;color:var(--muted);">See the <a href={`/templates/${trade.slug}-word/`} style="color:var(--blue);font-weight:600;">Word version</a> or the <a href={`/templates/${trade.slug}-excel/`} style="color:var(--blue);font-weight:600;">Excel version</a> of this template — each has format-specific tips.</p>
      </div>
    )}
    {format === 'word' && (
      <div class="variant-links" style="margin-top:24px;padding:16px 20px;background:var(--surface);border:1px solid var(--line);border-radius:12px;">
        <p style="font-size:14px;font-weight:700;margin-bottom:10px;">Other formats</p>
        <p style="font-size:14px;color:var(--muted);">See the <a href={`/templates/${trade.slug}/`} style="color:var(--blue);font-weight:600;">main template page</a> or the <a href={`/templates/${trade.slug}-excel/`} style="color:var(--blue);font-weight:600;">Excel version</a> — the Excel version auto-calculates tax and totals.</p>
      </div>
    )}
    {format === 'word' && (
      <div class="variant-links" style="margin-top:16px;padding:16px 20px;background:var(--soft);border:1px solid var(--line);border-radius:12px;">
        <p style="font-size:14px;font-weight:700;margin-bottom:8px;">Use it in Google Docs (free, no Microsoft Word needed)</p>
        <p style="font-size:14px;color:var(--muted);line-height:1.7;">Download the Word file above, then open <a href="https://docs.google.com" target="_blank" rel="noopener nofollow" style="color:var(--blue);font-weight:600;">Google Docs</a> → <em>File → Open → Upload</em> and drop the .docx in. Google Docs converts it in about ten seconds and keeps the layout, the table borders and the tax row. From there you can edit on your phone, share a copy with the customer, or export back to PDF without paying for Word. If you want the file to live in Drive permanently, upload it to Drive first and open it with Google Docs from there — that way the customer's copy and your master stay separate.</p>
      </div>
    )}
    {format === 'excel' && (
      <div class="variant-links" style="margin-top:24px;padding:16px 20px;background:var(--surface);border:1px solid var(--line);border-radius:12px;">
        <p style="font-size:14px;font-weight:700;margin-bottom:10px;">Other formats</p>
        <p style="font-size:14px;color:var(--muted);">See the <a href={`/templates/${trade.slug}/`} style="color:var(--blue);font-weight:600;">main template page</a> or the <a href={`/templates/${trade.slug}-word/`} style="color:var(--blue);font-weight:600;">Word version</a> — the Word version is easiest to edit and brand.</p>
      </div>
    )}
  </section>

  {/* 在线生成器 — 只在主页面、且是 GSC 位置最好的几个工种（工具闭环：下载 → 站内完成一单） */}
  {!format && builderSlugs.includes(trade.slug) && (
    <InvoiceBuilder
      slug={trade.slug}
      tradeName={trade.trade}
      lineItems={trade.lineItems}
      taxNote={trade.docType === 'invoice' ? 'Most states tax materials but not labor for services — leave tax at 0 if your labor is exempt in your state.' : undefined}
    />
  )}

  <section class="section wrap" id="how-to-use" style="padding-top:40px;">
    <div class="section-head">
      <h2>How to use this template</h2>
    </div>
    <p class="how-to-use-body">{howToUseText}</p>
    <div class="grid3" style="margin-top:24px;">
      {howToUseSteps.map((step) => (
        <div class="card">
          <h3 style="margin-bottom:8px;">{step.title}</h3>
          <p>{step.body}</p>
        </div>
      ))}
    </div>
  </section>

  {/* 焊工系页面 → 焊工估价计算器交叉链接（模板 ↔ 工具 互导流量） */}
  {/^weld/i.test(trade.trade) && (
    <section class="section wrap" id="calc-cta" style="padding-top:40px;">
      <div style="background:linear-gradient(135deg,#f0f7ff,#e8f4fe);border:1px solid #b8d8f5;border-radius:12px;padding:22px 26px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;">
        <div>
          <h2 style="font-size:21px;margin-bottom:6px;">Not sure what to charge?</h2>
          <p style="color:var(--muted);font-size:15px;margin:0;line-height:1.6;">Run the numbers first in the free <strong>Welding Estimate Calculator</strong> — MIG/TIG/stick labor, steel and consumables, mobilization, markup and deposit, all in your browser. Then drop the totals into this template.</p>
        </div>
        <a href="/welding-estimate-calculator/" style="background:var(--blue);color:#fff;padding:11px 22px;border-radius:8px;text-decoration:none;font-weight:600;white-space:nowrap;">Open the calculator →</a>
      </div>
    </section>
  )}

  {linkedGuide && (
    <section class="section wrap" id="guide-cta" style="padding-top:40px;">
      <div style="background:var(--soft);border-radius:12px;padding:24px 28px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;">
        <div>
          <h2 style="font-size:22px;margin-bottom:8px;">Complete guide: {linkedGuide.h1}</h2>
          <p style="color:var(--muted);font-size:15px;margin:0;">Step-by-step instructions, line-item examples, and tax tips for {trade.trade} invoicing — written for this template.</p>
        </div>
        <a href={`/guides/${linkedGuide.slug}/`} style="background:var(--blue);color:#fff;padding:10px 20px;border-radius:8px;text-decoration:none;font-weight:600;white-space:nowrap;">Read the guide →</a>
      </div>
    </section>
  )}

  {format === 'word' && (
    <section class="section wrap" id="word-tips" style="padding-top:40px;">
      <div class="section-head">
        <h2>Using this template in Word</h2>
        <p>Everything you can change in a few clicks — no design skills needed.</p>
      </div>
      <div class="grid3">
        <div class="card">
          <h3 style="margin-bottom:8px;">Edit the line items</h3>
          <p>Start with the pre-filled <strong>{exampleItem}</strong> row and adjust it to your actual job. Add or delete rows in the table — the layout stays aligned.</p>
        </div>
        <div class="card">
          <h3 style="margin-bottom:8px;">Add your branding</h3>
          <p>Drop your logo into the header box, change the accent color, and swap the default fonts to match your business. Everything is editable text, not an image.</p>
        </div>
        <div class="card">
          <h3 style="margin-bottom:8px;">Send it as a PDF</h3>
          <p>After editing, use File → Save As → PDF to send a polished invoice or estimate that the client cannot accidentally alter.</p>
        </div>
      </div>
      {trade.docType === 'invoice' && !ov.wordBillNote && (
        <p style="margin-top:24px;font-size:15px;color:var(--muted);line-height:1.7;">
          This Word file works as a ready-made <strong>{trade.trade} bill format</strong> — the same
          fields, layout, and line items as a printed bill, but fully editable. Many {trade.trade}s
          call it a bill, others an invoice; in Word the document is identical. Save a copy as your master
          bill template and reuse it for every job.
        </p>
      )}
      {ov.wordBillNote && (
        <p style="margin-top:24px;font-size:15px;color:var(--muted);line-height:1.7;">{ov.wordBillNote}</p>
      )}
    </section>
  )}

  {format === 'excel' && (
    <section class="section wrap" id="excel-tips" style="padding-top:40px;">
      <div class="section-head">
        <h2>Using this template in Excel</h2>
        <p>The math is already wired up — enter amounts, totals update themselves.</p>
      </div>
      <div class="grid3">
        <div class="card">
          <h3 style="margin-bottom:8px;">Built-in formulas</h3>
          <p>Subtotal, tax and total cells use live formulas (<code>=SUM(...)</code> and <code>=subtotal × rate</code>). Type your quantities and rates for rows like <strong>{exampleItem}</strong> and the invoice recalculates instantly.</p>
        </div>
        <div class="card">
          <h3 style="margin-bottom:8px;">Set your tax rate</h3>
          <p>The tax rate cell is left blank on purpose — look up your state's rate and enter it once. No rate required? Leave it empty and the total equals the subtotal.</p>
        </div>
        <div class="card">
          <h3 style="margin-bottom:8px;">Reuse for every job</h3>
          <p>Duplicate the sheet per client or save copies per project. Keep one master copy and your pricing history stays organized.</p>
        </div>
      </div>
    </section>
  )}

  <section class="section wrap" id="preview" style="padding-top:40px;">
    <div class="section-head">
      <h2>What the file looks like</h2>
      <p>Every field maps to data — swap the content, keep the structure.</p>
    </div>
    <figure class="preview-figure" style="margin:0;">
      <img
        src={`/previews/${trade.slug}.png`}
        srcset={`/previews/${trade.slug}.png 1000w, /previews/${trade.slug}@2x.png 2000w`}
        sizes="(max-width: 760px) 100vw, 760px"
        width="1000"
        height="1280"
        loading="lazy"
        decoding="async"
        alt={previewAlt}
        style="width:100%;max-width:760px;height:auto;border-radius:12px;border:1px solid var(--line);box-shadow:0 10px 30px rgba(22,40,59,.08);display:block;margin:0 auto;"
      />
      <figcaption style="text-align:center;font-size:13px;color:var(--muted);margin-top:10px;">Preview of the {trade.docType} layout — actual file is editable in Excel, Word &amp; PDF.</figcaption>
    </figure>
    <InvoicePreview trade={trade} />
  </section>

  <section class="section wrap" id="features" style="padding-top:40px;">
    <div class="section-head">
      <h2>Why this template works</h2>
      <p>{featuresSub}</p>
    </div>
    <div class="grid3">
      {(trade.features ?? []).map((f: string) => (
        <div class="card">
          <svg width="30" height="30" viewBox="0 0 32 32" fill="none" stroke="#1668D4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3l11 4v7c0 6.5-4.7 11.4-11 13C9.7 25.4 5 20.5 5 14V7z"/><path d="M12 16l3 3 6-6"/></svg>
          <h3 style="margin-bottom:8px;">{f.split(" — ")[0]}</h3>
          <p>{f.split(" — ").slice(1).join(" — ")}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section wrap" id="billing-guide" style="padding-top:40px;">
    <div class="section-head">
      <h2>{billingHeading}</h2>
      <p>{billingSub}</p>
    </div>
    <p class="how-to-use-body">{billingText}</p>
  </section>

  {/* 深度内容区块 — JSON 提供 deepDive 时渲染（GSC 数据驱动的内容增强，无字段页面输出不变） */}
  {trade.deepDive && (
    <section class="section wrap" id="deep-dive" style="padding-top:40px;">
      <div class="section-head">
        <h2>{trade.deepDive.heading}</h2>
        <p>{trade.deepDive.sub}</p>
      </div>
      {trade.deepDive.blocks.map((b: any) => (
        <div style="margin-top:28px;">
          <h3 style="font-size:19px;margin-bottom:10px;">{b.h3}</h3>
          {b.paras.map((p: string) => <p style="font-size:15px;line-height:1.75;color:var(--ink);margin-bottom:12px;">{p}</p>)}
          {b.list && (
            <ul style="font-size:15px;line-height:1.9;color:var(--ink);padding-left:22px;margin:6px 0 12px;">
              {b.list.map((li: string) => <li>{li}</li>)}
            </ul>
          )}
        </div>
      ))}
    </section>
  )}

  <section class="section wrap" id="whats-included" style="padding-top:40px;">
    <div class="section-head">
      <h2>What's included in this template</h2>
      <p>Every field you need — nothing you don't.</p>
    </div>
    <div class="grid2">
      <div class="card">
        <h3 style="margin-bottom:10px;">Header fields</h3>
        <ul style="list-style:none;padding:0;margin:0;font-size:14px;line-height:1.8;">
          {(trade.headerFields ?? []).map((f: string) => <li>· {f}</li>)}
        </ul>
      </div>
      <div class="card">
        <h3 style="margin-bottom:10px;">Bill-to fields</h3>
        <ul style="list-style:none;padding:0;margin:0;font-size:14px;line-height:1.8;">
          {(trade.billToFields ?? []).map((f: string) => <li>· {f}</li>)}
        </ul>
      </div>
      <div class="card" style="grid-column:1 / -1;">
        <h3 style="margin-bottom:10px;">Pre-filled line items</h3>
        <ul style="list-style:none;padding:0;margin:0;font-size:14px;line-height:1.8;">
          {(trade.lineItems ?? []).map((it: any) => <li>· {it.description} — {it.unit ?? 'each'} at ${it.sampleRate ?? 0}/{it.unit ?? 'each'}{it.taxable === false ? ' (non-taxable)' : ''}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section wrap" id="related" style="padding-top:40px;">
    <div class="section-head">
      <h2>Related templates</h2>
      <p>{relatedSub}</p>
    </div>
    <div class="grid3">
      {related.map((t: any) => (
        <a class="card" style="text-decoration:none;color:var(--ink);" href={`/templates/${t.slug}/`}>
          <span style="display:inline-block;font-size:12px;font-weight:700;letter-spacing:.4px;color:var(--teal);text-transform:uppercase;margin-bottom:8px;">{t.trade} · {t.docType}</span>
          <h3 style="margin-bottom:6px;color:var(--ink);">{t.title.replace(' Template', '')}</h3>
          <p style="color:var(--muted);font-size:14px;">Free {t.docType} template — Excel, Word &amp; PDF. Auto-calculating tax and totals.</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section wrap" id="popular" style="padding-top:40px;">
    <div class="section-head">
      <h2>Popular templates</h2>
      <p>Most-searched templates across all trades — free to download.</p>
    </div>
    <div class="grid3">
      {popular.map((t: any) => (
        <a class="card" style="text-decoration:none;color:var(--ink);" href={`/templates/${t.slug}/`}>
          <span style="display:inline-block;font-size:12px;font-weight:700;letter-spacing:.4px;color:var(--teal);text-transform:uppercase;margin-bottom:8px;">{t.trade} · {t.docType}</span>
          <h3 style="margin-bottom:6px;color:var(--ink);">{t.title.replace(' Template', '')}</h3>
          <p style="color:var(--muted);font-size:14px;">Free {t.docType} template — Excel, Word &amp; PDF. Auto-calculating tax and totals.</p>
        </a>
      ))}
    </div>
  </section>

  {rising.length > 0 && (
    <section class="section wrap" style="padding-top:18px;">
      <p style="font-size:15px;color:var(--muted);line-height:1.9;">
        Also useful for trades work:
        {rising.map((t: any, i: number) => (
          <span>
            {i > 0 && ' · '}
            <a href={`/templates/${t.slug}/`} style="color:var(--blue);font-weight:600;">{t.trade} {t.docType}</a>
          </span>
        ))}
      </p>
    </section>
  )}

  <section class="section wrap" id="faq">
    <div class="section-head">
      <h2>Questions</h2>
    </div>
    <FaqList faqs={trade.faqs ?? []} />
  </section>

  <script is:inline define:vars={{ itemSlug: trade.slug, itemTrade: trade.trade, itemDocType: trade.docType }}>
    if (window.gtag) gtag('event', 'view_item', {
      item_id: itemSlug,
      item_name: itemTrade + ' ' + itemDocType,
      item_category: itemDocType,
      item_category2: itemTrade,
    });
  </script>
</BaseLayout>